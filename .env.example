DATABASE_URL=postgres://clinic:clinicpassword@127.0.0.1:5433/clinic_app
PAYLOAD_SECRET=change-me

# Public site URL — used to absolutize upload URLs when running without S3
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Same origin, server-side. Payload needs this to tell its own file routes apart
# from bucket URLs; without it, admin thumbnails of S3-hosted images break.
SERVER_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Object storage (Liara)
# ---------------------------------------------------------------------------
# Leave S3_BUCKET empty to fall back to local disk storage (./media).
#
# Bucket layout, one top-level folder per upload collection:
#   media/<year>/<month>/   content photography  (public)
#   brand/                  logos and favicons   (public)
#   people/<year>/<month>/  staff portraits      (public)
#   documents/<year>/<month>/ downloadable files (private, signed URLs)
#
# The bucket must be set to Public in the Liara panel for the image folders to
# be served directly to browsers.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://storage.iran.liara.space
S3_REGION=us-east-1

# Optional: separate private bucket for `documents`. Defaults to S3_BUCKET.
# Set this if the main bucket is public and documents must not be.
S3_PRIVATE_BUCKET=

# Optional: CDN or custom domain in front of the bucket.
#
# Leave EMPTY for Liara. Setting it switches images to being served straight
# from the given origin instead of streamed through the app — and Liara's own
# bucket host (`<bucket>.storage.c2.liara.site`) answers browser User-Agents
# with `404 page not found`, so pointing this at the bucket breaks every image.
# Only set it once a CDN or custom domain that serves browsers sits in front.
S3_PUBLIC_URL=
